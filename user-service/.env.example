# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# JWT Configuration (keep existing values)
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Database Configuration (keep existing values)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=craftea_users

# MinIO Configuration (keep existing values)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=avatars

# Email Configuration (keep existing values)
RESEND_API_KEY=your_resend_api_key_or_placeholder
EMAIL_FROM=Craftea <noreply@craftea.com>

# App Configuration (keep existing values)
APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3002
